{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Error message from Relay",
  "type": "object",
  "properties": {
    "type": { "type": "string" },
    "payload": {
      "description": "bytes"
    },
    "event_id": { "type": "string" },
    "project_id": { "type": "integer" },
    "start_time": { "type": "integer" },
    "attachments": {
      "description": "Attachments that are potentially relevant for processing the event, such as minidumps.",
      "type": "array",
      "items": {
        "$ref": "file://ingest-attachments.v1.schema.json#/definitions/ChunkedAttachment"
      }
    }
  },
  "required": ["type", "event_id", "project_id", "payload", "start_time"]
}
